---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-600.css';
import '../style.css';
const trips=[
 {city:'Nürnberg',id:'nuernberg',country:'Deutschland',title:'Pizza unter Sternen',detail:'Pizza All you can eat inkl. Planetarium in Nbg',copy:'Erst so viele Stücke Pizza, wie wir mögen. Dann machen wir es uns unter dem Sternenhimmel im Planetarium gemütlich. Anschließend gehört die Nacht uns beiden im Hotel.'},
 {city:'Wien',id:'wien',country:'Österreich',title:'Hotel Lust – in Wien',detail:'Eine Woche später',copy:'Eine Woche später könnten wir in Wien aufwachen. Ich schenke dir eine Nacht im Hotel Lust. Was wir zwischen Einchecken und Ausschlafen machen, entscheiden wir zwei.'}
];
---
<!doctype html><html lang="de"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#f6ddd5"/><title>Reisepost für Sophia</title></head>
<body><header><a class="brand" href="#anfang"><span class="mark" aria-hidden="true">♡</span>Reisepost</a><nav aria-label="Hauptnavigation"><a href="#brief">Dein Brief</a><a href="#reisen">Reiseideen</a><a class="nav-choice" href="#wahl">Deine Wahl <span>↗</span></a></nav></header>
<main><section class="hero" id="anfang"><div class="intro"><div class="eyebrow"><i></i> GEBURTSTAGSPOST FÜR DICH</div><h1>Liebste<br/><em>Sophia,</em><span class="heart" aria-hidden="true">♡</span></h1><p>Zum Geburtstag schenke ich dir eine Nacht zu zweit.<br class="wide"/> Du suchst aus, wo wir aufwachen.</p><a class="primary" href="#reisen">Reiseideen entdecken <span>↓</span></a></div>
<div class="collage" aria-label="Illustrierte Reisepostkarten von Wien und Nürnberg">
{[trips[1],trips[0]].map((t,i)=><a class={'postcard pc'+i} href={'#'+t.id} aria-label={t.city+' entdecken'}><img src={'/'+t.id+'.webp'} alt=""/><div class="caption"><small>GRÜSSE AUS</small><strong>{t.city}</strong></div><span class="post-foot">{t.country} <b>✦</b> EUROPA</span></a>)}
<div class="seal" aria-hidden="true"><span>MIT LIEBE</span>♡<small>FÜR DICH</small></div></div>
<div class="hero-foot"><span>01 / 03</span><span class="hair"></span><a href="#brief">WEITERLESEN ↓</a></div></section>
<section id="brief" class="letter"><div class="eyebrow">01 &nbsp;/ &nbsp; DEIN BRIEF</div><h2>Alles Liebe zum Geburtstag,<br/><em>mein Herz.</em></h2><p>Am liebsten schenke ich dir Zeit. Einen Abend, an dem wir beide noch sitzen bleiben können, weil die Betten schon auf uns warten. Zwei Ideen habe ich für uns ausgesucht. Du darfst dir deine liebste aussuchen.</p><span class="signature">In Liebe ♡</span></section>
<section id="reisen" class="journeys"><div class="rail"><div class="eyebrow">02 &nbsp;/ &nbsp; REISEIDEEN</div><h2>Wohin zieht<br/>es <em>dich?</em></h2><div class="indicator"><i></i>{trips.map(t=><a href={'#'+t.id}>{t.city}</a>)}</div></div><div class="stories">{trips.map((t,i)=><article id={t.id}><img src={'/'+t.id+'.webp'} alt={'Illustrierte Stadtansicht von '+t.city}/><div class="story-text"><div class="eyebrow">{t.city} · {t.country}</div><h3>{t.title}</h3><strong>{t.detail}</strong><p>{t.copy}</p><a href="#wahl">Zur Auswahl ↓</a></div></article>)}</div></section>
<section class="decision" id="wahl"><div class="eyebrow">03 &nbsp;/ &nbsp; DEINE WAHL</div><h2>Wo wachen wir <em>auf?</em></h2><p>Such dir unsere gemeinsame Nacht aus.</p><div class="buttons">{trips.map(t=><button type="button" data-city={t.city} aria-pressed="false">{t.city} wählen <span>♡</span></button>)}</div><p class="result" role="status"></p></section></main><footer><span>Reisepost für Sophia</span><a href="#anfang">Zurück nach oben ↑</a></footer>
<script>
import {gsap} from 'gsap';
import {ScrollTrigger} from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);
const mm=gsap.matchMedia();
mm.add('(prefers-reduced-motion: no-preference)',()=>{
gsap.from('.intro > *',{y:12,opacity:0,duration:.6,stagger:.07});
gsap.from('.postcard',{y:32,duration:.95,stagger:.12,ease:'power3.out'});
});
const links=[...document.querySelectorAll<HTMLAnchorElement>('.indicator a')];
document.querySelectorAll('.stories article').forEach((article,i)=>{
function activate(){links.forEach((link,j)=>link.setAttribute('aria-current',i===j?'location':'false'));gsap.set('.indicator i',{yPercent:i*100});}
ScrollTrigger.create({trigger:article,start:'top 55%',end:'bottom 55%',onEnter:activate,onEnterBack:activate});
});
const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-city]')];
function select(city:string){if(!buttons.some(b=>b.dataset.city===city))return;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.city===city)));document.querySelector<HTMLElement>('.result')!.textContent='Dann geht’s für uns nach '+city+'! ♡';}
try{select(localStorage.getItem('sophias-reisewahl')||'')}catch{}
buttons.forEach(b=>b.addEventListener('click',()=>{const city=b.dataset.city!;select(city);try{localStorage.setItem('sophias-reisewahl',city)}catch{}}));
</script></body></html>
